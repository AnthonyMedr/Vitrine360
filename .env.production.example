# GAMEL Metal Digital - producao Fase 1
# Escopo imediato: site institucional + catalogo inteligente + orcamento online + painel admin.
# Nao coloque secrets reais neste arquivo. Copie para .env no servidor e preencha em cofre/ambiente seguro.

APP_ENV=production
NODE_ENV=production
HOMOLOGATION_ONLY=false

APP_BASE_URL=https://www.gamelmetal.com
API_BASE_URL=https://www.gamelmetal.com
API_PORT=3001
CORS_ALLOWED_ORIGINS=https://www.gamelmetal.com,https://gamelmetal.com
STORE_WHATSAPP=5587981818752

VITE_API_BASE_URL=
VITE_SITE_MODE=quote
VITE_ECOMMERCE_ENABLED=false
VITE_CART_ENABLED=false
VITE_CHECKOUT_ENABLED=false
VITE_PAYMENTS_ENABLED=false
VITE_STRIPE_ENABLED=false
VITE_ORDER_TRACKING_ENABLED=false
VITE_CUSTOMER_ACCOUNT_ENABLED=false
VITE_QUOTE_ENABLED=true
VITE_WHATSAPP_ENABLED=true
VITE_ADMIN_ENABLED=true
VITE_CATALOG_SOURCE=api
VITE_EVENTS_ENABLED=true
VITE_WEBHOOK_ENABLED=false

TRUST_PROXY=true
SECURE_COOKIES=true
APP_SECRET=__SET_IN_PRODUCTION__
AUTH_SESSION_SECRET=__SET_IN_PRODUCTION__
AUTH_CSRF_COOKIE_NAME=gamel_csrf
AUTH_CSRF_HEADER_NAME=x-csrf-token
AUTH_CSRF_SECRET=__SET_IN_PRODUCTION__
AUTH_PUBLIC_SIGNUP_ENABLED=false
METRICS_TOKEN=__SET_IN_PRODUCTION__
LOG_LEVEL=info
ENABLE_SECURITY_HEADERS=true
INTEGRATION_SECRETS_KEY=__SET_IN_PRODUCTION__

DB_PROVIDER=postgres
DATABASE_URL=__SET_IN_PRODUCTION__
POSTGRES_SSL=true
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_IDLE_TIMEOUT_MS=10000
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_TRANSACTION_MAX_WAIT_MS=10000
POSTGRES_TRANSACTION_TIMEOUT_MS=60000

QUEUE_PROVIDER=redis
REDIS_URL=__SET_IN_PRODUCTION__
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=__SET_IN_PRODUCTION__
REDIS_RATE_LIMIT_PREFIX=gamel:rate-limit
REDIS_QUEUE_PREFIX=gamel:queue
PUBLIC_CATALOG_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_CATALOG_RATE_LIMIT_MAX=240
QUOTE_RATE_LIMIT_WINDOW_MS=60000
QUOTE_RATE_LIMIT_MAX=12
QUOTE_DEDUPE_WINDOW_MS=300000
ADMIN_API_RATE_LIMIT_WINDOW_MS=60000
ADMIN_API_RATE_LIMIT_MAX=600

# Fase 1: sem venda online. Pagamento e frete calculado ficam em stand by.
PAYMENT_PROVIDER=manual
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=
PAYMENT_SUCCESS_URL=
PAYMENT_FAILURE_URL=
PAYMENT_PENDING_URL=

SHIPPING_PROVIDER=local-rules
FREIGHT_PROVIDER=local-rules
FREIGHT_API_KEY=
FREIGHT_ORIGIN_CEP=__SET_IN_PRODUCTION__
FREIGHT_SANDBOX=false
FREIGHT_TIMEOUT_MS=12000
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ORIGIN_ZIP=
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_SANDBOX=true
MELHOR_ENVIO_APP_NAME=GamelMetal
MELHOR_ENVIO_CONTACT_EMAIL=comercial@gamelmetal.com
MELHOR_ENVIO_REQUEST_TIMEOUT_MS=12000

FISCAL_PROVIDER=manual
FISCAL_API_URL=
FISCAL_API_TOKEN=
FISCAL_COMPANY_CNPJ=64156323000151
FISCAL_ENV=production

ERP_PROVIDER=none
ERP_API_URL=
ERP_API_TOKEN=
ERP_SYNC_ENABLED=false

EMAIL_PROVIDER=resend
EMAIL_FROM="GAMEL Metal <nao-responda@gamelmetal.com>"
EMAIL_API_KEY=__SET_IN_PRODUCTION__
RESEND_API_KEY=__SET_IN_PRODUCTION__
RESEND_FROM="GAMEL Metal <nao-responda@gamelmetal.com>"
RESEND_REPLY_TO=comercial@gamelmetal.com

ANALYTICS_PROVIDER=ga4
ANALYTICS_ID=__SET_IN_PRODUCTION__
TAG_MANAGER_ID=
GA4_MEASUREMENT_ID=__SET_IN_PRODUCTION__
GA4_API_SECRET=__SET_IN_PRODUCTION__

# Storage de objetos S3/MinIO. Deixe STORAGE_PUBLIC_BASE_URL vazio para usar o proxy privado da API.
STORAGE_PROVIDER=minio
STORAGE_PUBLIC_BASE_URL=https://cdn.gamelmetal.com
STORAGE_BUCKET=__SET_IN_PRODUCTION__
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=__SET_IN_PRODUCTION__
STORAGE_FORCE_PATH_STYLE=true
STORAGE_AUTO_CREATE_BUCKET=false
STORAGE_UPLOAD_MAX_BYTES=5242880
STORAGE_ACCESS_KEY_ID=__SET_IN_PRODUCTION__
STORAGE_SECRET_ACCESS_KEY=__SET_IN_PRODUCTION__
CDN_BASE_URL=https://cdn.gamelmetal.com

AI_ENABLED=false
AI_MAX_DAILY_CALLS=200
AI_MAX_INPUT_CHARS=6000
AI_CACHE_TTL_DAYS=30
AI_BATCH_MAX_ITEMS=12
OPENAI_API_KEY=
OPENAI_FISCAL_MODEL=gpt-5.2
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REQUEST_TIMEOUT_MS=20000
