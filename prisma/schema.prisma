generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The application still exposes its established domain-shaped snapshot API.
// Each aggregate is persisted independently so writes are transactional and
// no longer truncate/rebuild every PostgreSQL table.
model RuntimeRecord {
  collection String   @db.VarChar(80)
  id         String
  payload    Json
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([collection, id])
  @@index([collection])
  @@map("runtime_records")
}

model RuntimeMeta {
  key       String   @id @db.VarChar(80)
  payload   Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("runtime_meta")
}

model StoredObject {
  key          String    @id
  bucket       String
  provider     String    @db.VarChar(24)
  publicUrl    String    @map("public_url")
  contentType  String    @map("content_type")
  sizeBytes    Int       @map("size_bytes")
  checksumSha256 String  @map("checksum_sha256") @db.VarChar(64)
  etag         String?
  originalName String?   @map("original_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([provider, bucket])
  @@index([createdAt])
  @@map("stored_objects")
}
