# GAMEL Metal Digital - exemplo de ambiente local/homologacao
# Nao coloque secrets reais neste arquivo. Copie para .env e preencha no ambiente seguro.

# Ambiente
APP_ENV=development
HOMOLOGATION_ONLY=true
API_PORT=3001
APP_BASE_URL=http://127.0.0.1:5173
API_BASE_URL=http://127.0.0.1:3001
VITE_API_BASE_URL=
VITE_SITE_MODE=quote
VITE_ECOMMERCE_ENABLED=false
VITE_CART_ENABLED=false
VITE_CHECKOUT_ENABLED=false
VITE_PAYMENTS_ENABLED=false
VITE_STRIPE_ENABLED=false
VITE_ORDER_TRACKING_ENABLED=false
VITE_CUSTOMER_ACCOUNT_ENABLED=false
VITE_QUOTE_ENABLED=true
VITE_QUOTE_CART_ENABLED=true
VITE_QUOTE_CART_PROFILE=essential
VITE_PUBLIC_PRICES_ENABLED=false
VITE_WHATSAPP_ENABLED=true
VITE_ADMIN_ENABLED=true
VITE_CATALOG_SOURCE=local
VITE_EVENTS_ENABLED=true
VITE_WEBHOOK_ENABLED=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=false
SECURE_COOKIES=false

# Banco e fila
# Local: DB_PROVIDER=sqlite, QUEUE_PROVIDER=auto.
# Produção/fase estadual: DB_PROVIDER=postgres, QUEUE_PROVIDER=redis, DATABASE_URL e REDIS_URL reais.
DATA_DIR=
DB_PROVIDER=sqlite
DATABASE_URL=
POSTGRES_SSL=true
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_IDLE_TIMEOUT_MS=10000
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_TRANSACTION_MAX_WAIT_MS=10000
POSTGRES_TRANSACTION_TIMEOUT_MS=60000
QUEUE_PROVIDER=auto
REDIS_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=
REDIS_RATE_LIMIT_PREFIX=gamel:rate-limit
REDIS_QUEUE_PREFIX=gamel:queue
PUBLIC_CATALOG_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_CATALOG_RATE_LIMIT_MAX=240
QUOTE_RATE_LIMIT_WINDOW_MS=60000
QUOTE_RATE_LIMIT_MAX=12
QUOTE_DEDUPE_WINDOW_MS=300000
ADMIN_API_RATE_LIMIT_WINDOW_MS=60000
ADMIN_API_RATE_LIMIT_MAX=600

# Storage e observabilidade
STORAGE_PROVIDER=local
STORAGE_PUBLIC_BASE_URL=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_AUTO_CREATE_BUCKET=false
STORAGE_UPLOAD_MAX_BYTES=5242880
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
METRICS_TOKEN=
LOG_LEVEL=info
ENABLE_SECURITY_HEADERS=true

# OpenAI / assistente fiscal
# Opcional em desenvolvimento: sem OPENAI_API_KEY o assistente opera em modo heuristico/manual.
AI_ENABLED=false
AI_MAX_DAILY_CALLS=200
AI_MAX_INPUT_CHARS=6000
AI_CACHE_TTL_DAYS=30
AI_BATCH_MAX_ITEMS=12
OPENAI_API_KEY=
OPENAI_FISCAL_MODEL=gpt-5.2
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REQUEST_TIMEOUT_MS=20000

# Segurança/autenticação
AUTH_SESSION_DAYS=7
AUTH_OTP_TTL_MINUTES=10
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=10
AUTH_CSRF_COOKIE_NAME=gamel_csrf
AUTH_CSRF_HEADER_NAME=x-csrf-token
AUTH_CSRF_SECRET=troque-por-um-segredo-forte-local
AUTH_PUBLIC_SIGNUP_ENABLED=false

# Pagamentos
# Regional assistido: PAYMENT_PROVIDER=manual.
# Produção aberta com pagamento online: PAYMENT_PROVIDER=mercadopago e credenciais reais.
PAYMENT_PROVIDER=manual
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SUCCESS_URL=
MERCADO_PAGO_FAILURE_URL=
MERCADO_PAGO_PENDING_URL=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=
PAYMENT_SUCCESS_URL=
PAYMENT_FAILURE_URL=
PAYMENT_PENDING_URL=
MERCADOPAGO_REQUEST_TIMEOUT_MS=12000

# Frete
# Regional: FREIGHT_PROVIDER=local-rules.
# Estadual/nacional: provider real homologado, token real e CEP de origem real.
SHIPPING_PROVIDER=local-rules
FREIGHT_PROVIDER=local-rules
FREIGHT_API_KEY=
FREIGHT_ORIGIN_CEP=
FREIGHT_SANDBOX=true
FREIGHT_TIMEOUT_MS=12000
FREIGHT_SORT_STRATEGY=cheapest
FREIGHT_CACHE_TTL_MS=1200000
ORIGIN_ZIP_CODE=55290000
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ORIGIN_ZIP=
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_SANDBOX=true
MELHOR_ENVIO_APP_NAME=GamelMetal
MELHOR_ENVIO_CONTACT_EMAIL=comercial@gamelmetal.com
MELHOR_ENVIO_REQUEST_TIMEOUT_MS=12000
CORREIOS_TOKEN=
CORREIOS_ORIGIN_ZIP=
CORREIOS_ENV=sandbox
CORREIOS_SERVICES=03220:SEDEX,03298:PAC
CORREIOS_REQUEST_TIMEOUT_MS=12000
FRENET_TOKEN=
FRENET_ORIGIN_ZIP=
FRENET_REQUEST_TIMEOUT_MS=12000
FRETE_BARATO_TOKEN=
FRETE_BARATO_CUSTOMER_ID=
FRETE_BARATO_PLATFORM=lojaintegrada
FRETE_BARATO_REQUEST_TIMEOUT_MS=12000
CEPCERTO_TOKEN=
CEPCERTO_ORIGIN_ZIP=
CEPCERTO_REQUEST_TIMEOUT_MS=12000

# Email
EMAIL_PROVIDER=log
EMAIL_FROM="GAMEL Metal <nao-responda@gamelmetal.com>"
EMAIL_API_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM="GAMEL Metal <nao-responda@gamelmetal.com>"
RESEND_REPLY_TO=comercial@gamelmetal.com

# Analytics
ANALYTICS_PROVIDER=none
ANALYTICS_ID=
TAG_MANAGER_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
VITE_GA_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=

# Alias opcional para CDN
CDN_BASE_URL=
