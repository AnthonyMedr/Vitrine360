# Copie para .env e substitua todos os valores antes de subir o Compose.
APP_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
APP_PORT=3001
TRUST_PROXY=false
SECURE_COOKIES=false

POSTGRES_DB=vitrine360
POSTGRES_USER=vitrine360
POSTGRES_PASSWORD=troque-por-uma-senha-postgres-forte
POSTGRES_MAX_CONNECTIONS=10
DATABASE_URL=postgresql://vitrine360:troque-por-uma-senha-postgres-forte@postgres:5432/vitrine360

REDIS_PASSWORD=troque-por-uma-senha-redis-forte
REDIS_URL=redis://:troque-por-uma-senha-redis-forte@redis:6379/0

MINIO_ROOT_USER=vitrine360-minio
MINIO_ROOT_PASSWORD=troque-por-uma-senha-minio-com-mais-de-16-caracteres
MINIO_CONSOLE_PORT=9001
STORAGE_BUCKET=vitrine360-media
STORAGE_UPLOAD_MAX_BYTES=5242880
STORAGE_PUBLIC_BASE_URL=

APP_SECRET=troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres
AUTH_CSRF_SECRET=troque-por-outro-segredo-aleatorio-com-no-minimo-32-caracteres
INTEGRATION_SECRETS_KEY=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
METRICS_TOKEN=troque-por-um-token-aleatorio-com-no-minimo-32-caracteres

ADMIN_EMAIL=admin@seu-dominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-admin-exclusiva-e-forte
ADMIN_NAME=Administrador
