# GAMEL Digital 360 - exemplo para homologacao real
# Nao inserir secrets reais neste arquivo. Use cofre/ambiente seguro.

APP_ENV=homologation
HOMOLOGATION_ONLY=true
APP_BASE_URL=https://homologacao.seu-dominio.com.br
API_BASE_URL=https://api-homologacao.seu-dominio.com.br
API_PORT=3001
CORS_ALLOWED_ORIGINS=https://homologacao.seu-dominio.com.br

TRUST_PROXY=true
SECURE_COOKIES=true
AUTH_CSRF_SECRET=__SET_IN_SECURE_ENV__
METRICS_TOKEN=__SET_IN_SECURE_ENV__

DB_PROVIDER=postgres
DATABASE_URL=__SET_IN_SECURE_ENV__
QUEUE_PROVIDER=redis
REDIS_URL=__SET_IN_SECURE_ENV__

PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=__SET_IN_SECURE_ENV__
MERCADOPAGO_PUBLIC_KEY=__SET_IN_SECURE_ENV__
MERCADOPAGO_WEBHOOK_SECRET=__SET_IN_SECURE_ENV__
MERCADOPAGO_WEBHOOK_URL=https://api-homologacao.seu-dominio.com.br/api/webhooks/mercadopago
PAYMENT_SUCCESS_URL=https://homologacao.seu-dominio.com.br/checkout/sucesso
PAYMENT_FAILURE_URL=https://homologacao.seu-dominio.com.br/checkout/falha
PAYMENT_PENDING_URL=https://homologacao.seu-dominio.com.br/checkout/pendente

FREIGHT_PROVIDER=melhor-envio
FREIGHT_API_KEY=__SET_IN_SECURE_ENV__
FREIGHT_ORIGIN_CEP=__SET_IN_SECURE_ENV__
FREIGHT_SANDBOX=true
FREIGHT_TIMEOUT_MS=12000
MELHOR_ENVIO_TOKEN=__SET_IN_SECURE_ENV__
MELHOR_ENVIO_ORIGIN_ZIP=__SET_IN_SECURE_ENV__
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_SANDBOX=true

EMAIL_PROVIDER=resend
EMAIL_FROM="GAMEL <nao-responda@gamelmetal.com>"
EMAIL_API_KEY=__SET_IN_SECURE_ENV__
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
RESEND_API_KEY=__SET_IN_SECURE_ENV__

ANALYTICS_PROVIDER=ga4
ANALYTICS_ID=__SET_IN_SECURE_ENV__
TAG_MANAGER_ID=
GA4_MEASUREMENT_ID=__SET_IN_SECURE_ENV__
GA4_API_SECRET=__SET_IN_SECURE_ENV__

STORAGE_PROVIDER=minio
STORAGE_BUCKET=__SET_IN_SECURE_ENV__
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=__SET_IN_SECURE_ENV__
STORAGE_ACCESS_KEY_ID=__SET_IN_SECURE_ENV__
STORAGE_SECRET_ACCESS_KEY=__SET_IN_SECURE_ENV__
STORAGE_FORCE_PATH_STYLE=true
STORAGE_AUTO_CREATE_BUCKET=false
STORAGE_UPLOAD_MAX_BYTES=5242880
CDN_BASE_URL=https://cdn-homologacao.seu-dominio.com.br
