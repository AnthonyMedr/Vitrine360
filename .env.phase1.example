DB_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gamel_digital
QUEUE_PROVIDER=redis
REDIS_URL=redis://127.0.0.1:6379
APP_SECRET=__SET_IN_PHASE1__
AUTH_CSRF_SECRET=__SET_IN_PHASE1__
AUTH_PUBLIC_SIGNUP_ENABLED=false
METRICS_TOKEN=__SET_IN_PHASE1__
INTEGRATION_SECRETS_KEY=__SET_IN_PHASE1__
TRUST_PROXY=true
SECURE_COOKIES=true
HOMOLOGATION_ONLY=true
APP_ENV=production
APP_BASE_URL=https://www.gamelmetal.com
API_BASE_URL=https://api.gamelmetal.com
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=gamel-media
STORAGE_ACCESS_KEY_ID=__SET_IN_PHASE1__
STORAGE_SECRET_ACCESS_KEY=__SET_IN_PHASE1__
STORAGE_FORCE_PATH_STYLE=true
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_UPLOAD_MAX_BYTES=5242880
EMAIL_PROVIDER=log
ANALYTICS_PROVIDER=none
