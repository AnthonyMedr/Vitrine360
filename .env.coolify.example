# Vitrine360 - exemplo de producao para Coolify
# Cadastre estes valores em Environment Variables no Coolify.
# Nunca salve senhas, tokens, IPs privados ou URLs com credenciais neste arquivo.

# Aplicacao
APP_ENV=production
NODE_ENV=production
HOMOLOGATION_ONLY=false
API_PORT=3001
APP_BASE_URL=https://www.seudominio.com.br
API_BASE_URL=https://www.seudominio.com.br
CORS_ALLOWED_ORIGINS=https://www.seudominio.com.br,https://seudominio.com.br

# Proxy e seguranca
TRUST_PROXY=true
SECURE_COOKIES=true
ENABLE_SECURITY_HEADERS=true
APP_SECRET=__SET_IN_COOLIFY__
AUTH_CSRF_SECRET=__SET_IN_COOLIFY__
INTEGRATION_SECRETS_KEY=__SET_IN_COOLIFY__
METRICS_TOKEN=__SET_IN_COOLIFY__
AUTH_PUBLIC_SIGNUP_ENABLED=false

# PostgreSQL: copie a Internal URL exibida pelo recurso no Coolify.
DB_PROVIDER=postgres
DATABASE_URL=__SET_IN_COOLIFY__
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_MAX_CONNECTIONS=10

# Redis: copie a Internal URL exibida pelo recurso no Coolify.
QUEUE_PROVIDER=redis
REDIS_URL=__SET_IN_COOLIFY__
REDIS_RATE_LIMIT_PREFIX=vitrine360:rate-limit
REDIS_QUEUE_PREFIX=vitrine360:queue
RATE_LIMIT_ENABLED=true

# MinIO: use o endpoint interno na porta 9000, nunca a console 9001.
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=__SET_IN_COOLIFY__
STORAGE_BUCKET=vitrine360-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=__SET_IN_COOLIFY__
STORAGE_SECRET_ACCESS_KEY=__SET_IN_COOLIFY__
STORAGE_FORCE_PATH_STYLE=true
STORAGE_AUTO_CREATE_BUCKET=false
STORAGE_UPLOAD_MAX_BYTES=5242880
STORAGE_PUBLIC_BASE_URL=

# Administrador inicial. Os valores reais ficam somente no Coolify.
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=__SET_IN_COOLIFY__
ADMIN_NAME=Administrador

# Providers opcionais
PAYMENT_PROVIDER=manual
FREIGHT_PROVIDER=local-rules
FISCAL_PROVIDER=manual
ERP_PROVIDER=none
EMAIL_PROVIDER=log
ANALYTICS_PROVIDER=none
AI_ENABLED=false

# Frontend: disponibilize apenas estas variaveis durante o build.
VITE_API_BASE_URL=
VITE_SITE_MODE=quote
VITE_ECOMMERCE_ENABLED=false
VITE_CART_ENABLED=false
VITE_CHECKOUT_ENABLED=false
VITE_PAYMENTS_ENABLED=false
VITE_ORDER_TRACKING_ENABLED=false
VITE_CUSTOMER_ACCOUNT_ENABLED=false
VITE_QUOTE_ENABLED=true
VITE_QUOTE_CART_ENABLED=true
VITE_WHATSAPP_ENABLED=true
VITE_ADMIN_ENABLED=true
VITE_CATALOG_SOURCE=api
VITE_EVENTS_ENABLED=true
VITE_WEBHOOK_ENABLED=false