# Vitrine360 - exemplo de producao para Coolify
# Cadastre estes valores em Environment Variables no Coolify.
# Nunca salve senhas ou tokens reais neste arquivo.

# Aplicacao
APP_ENV=production
NODE_ENV=production
HOMOLOGATION_ONLY=false
API_PORT=3001
APP_BASE_URL=https://www.seudominio.com.br
API_BASE_URL=https://www.seudominio.com.br
CORS_ALLOWED_ORIGINS=https://www.seudominio.com.br,https://seudominio.com.br

# Proxy e seguranca
TRUST_PROXY=true
SECURE_COOKIES=true
ENABLE_SECURITY_HEADERS=true
APP_SECRET=PQ-PtuytOrA1lAY7whCe-N_cCm9EC0ZIcBhSRkc_izrkD6gIXs8bASEcxbwzX6u5
AUTH_CSRF_SECRET=P1-FYh2fLurvfFFcNUaL8a00zd5M37U8hB71QcWjzRvAP48dJCrXQ4FJ6mZU5LIj
INTEGRATION_SECRETS_KEY=hsmoyVtwp8mJpLzVYeNr_ufTb0e_irG6_AZIqMV6XvX75JtSufZZGKhkr9vnormH
METRICS_TOKEN=9pnFkTY8bgahODfFe-2jF6kv0EpuYxawGBWtyYZp35k
AUTH_PUBLIC_SIGNUP_ENABLED=false

# PostgreSQL interno do Coolify
# Use a Internal URL exibida pelo recurso PostgreSQL.
DB_PROVIDER=postgres
DATABASE_URL=postgres://postgres:mTzVut484VhiIv3MhE70LTlR0cpq45PQdmGYgzOI61JoNubMRmAIVXzq9ZPL9BCm@2.25.124.193:5432/postgres
# O PostgreSQL interno do Coolify normalmente nao usa TLS.
# Para um banco externo com TLS, altere para true.
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_MAX_CONNECTIONS=10

# Redis interno do Coolify
# Use a Internal URL exibida pelo recurso Redis.
QUEUE_PROVIDER=redis
REDIS_URL=redis://default:89wK2eh0ZEtjGteSsofLeVaFAsUOa9QfXqJSw7YF1xW6Mw9QT3c3rQoCdBcKzlhj@irbc6igwpyfgisrmnsczoiue:6379/0
REDIS_RATE_LIMIT_PREFIX=vitrine360:rate-limit
REDIS_QUEUE_PREFIX=vitrine360:queue
RATE_LIMIT_ENABLED=true

# MinIO interno do Coolify
# Exemplo de endpoint interno: http://nome-do-servico-minio:9000
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=https://s3.gamelmetal.com
STORAGE_BUCKET=gamel
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=Zp779aguKxSHc0FbCa9v
STORAGE_SECRET_ACCESS_KEY=tJAvrxXXUo66TDKOa9g9YgfdWImBQMLuaOgXBsdx
STORAGE_FORCE_PATH_STYLE=true
STORAGE_AUTO_CREATE_BUCKET=false
STORAGE_UPLOAD_MAX_BYTES=5242880
# Deixe vazio para servir as imagens pela propria API em /uploads.
# Informe uma URL publica apenas se configurar dominio/CDN para os objetos.
STORAGE_PUBLIC_BASE_URL=https://console.gamelmetal.com

# Administrador inicial
# Usado uma vez com: npm run admin:bootstrap
ADMIN_EMAIL=admin@infinitilabs.com.br
ADMIN_PASSWORD=Kpedro@gamel2026
ADMIN_NAME=Administrador

# Providers opcionais: configuracao inicial sem cobranca/venda automatica
PAYMENT_PROVIDER=manual
FREIGHT_PROVIDER=local-rules
FISCAL_PROVIDER=manual
ERP_PROVIDER=none
EMAIL_PROVIDER=log
ANALYTICS_PROVIDER=none
AI_ENABLED=false

# Frontend servido no mesmo dominio da API.
# Variaveis VITE sao aplicadas durante o build da imagem.
VITE_API_BASE_URL=
VITE_SITE_MODE=quote
VITE_ECOMMERCE_ENABLED=false
VITE_CART_ENABLED=false
VITE_CHECKOUT_ENABLED=false
VITE_PAYMENTS_ENABLED=false
VITE_ORDER_TRACKING_ENABLED=false
VITE_CUSTOMER_ACCOUNT_ENABLED=false
VITE_QUOTE_ENABLED=true
VITE_QUOTE_CART_ENABLED=true
VITE_WHATSAPP_ENABLED=true
VITE_ADMIN_ENABLED=true
VITE_CATALOG_SOURCE=api
VITE_EVENTS_ENABLED=true
VITE_WEBHOOK_ENABLED=false